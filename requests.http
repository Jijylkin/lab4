@baseUrl = http://localhost:8080
@captain = patriot@mail.ru
@second = kozel@mail.ru
@third = titan@mail.ru

### Без авторизации (401)
GET {{baseUrl}}/api/tournaments

### CSRF-токен (200)
GET {{baseUrl}}/api/account/csrf

> {% client.global.set("csrfToken", response.body.token); %}

### Слишком простой пароль (400)
POST {{baseUrl}}/api/account/register
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Игрок", "email": "{{captain}}", "password": "12345"}

### Регистрация капитана (Хоумлендеров Олег), роль остаётся PLAYER (201)
POST {{baseUrl}}/api/account/register
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Хоумлендеров Олег", "email": "{{captain}}", "password": "Captain2026!", "role": "ORGANIZER"}

> {% client.global.set("captainId", response.body.id); %}

### Повторный email (409)
POST {{baseUrl}}/api/account/register
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Хоумлендеров Олег", "email": "{{captain}}", "password": "Captain2026!"}

### Второй капитан (Козлов Алексей) (201)
POST {{baseUrl}}/api/account/register
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Козлов Алексей", "email": "{{second}}", "password": "Captain2026!"}

> {% client.global.set("secondId", response.body.id); %}

### Третий капитан (Титамир Богдан) (201)
POST {{baseUrl}}/api/account/register
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Титамир Богдан", "email": "{{third}}", "password": "Captain2026!"}

> {% client.global.set("thirdId", response.body.id); %}

### Ошибка пароля (401)
GET {{baseUrl}}/api/account/me
Authorization: Basic {{captain}} WrongPassword1

### Профиль игрока (Хоумлендеров Олег) (200)
GET {{baseUrl}}/api/account/me
Authorization: Basic {{captain}} Captain2026!

### Игрок не получает список пользователей (403)
GET {{baseUrl}}/api/users
Authorization: Basic {{captain}} Captain2026!

### Самому повысить роль нельзя (403)
PATCH {{baseUrl}}/api/users/{{captainId}}
Authorization: Basic {{captain}} Captain2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"role": "ORGANIZER"}

### Игрок не создаёт турниры (403)
POST {{baseUrl}}/api/tournaments
Authorization: Basic {{captain}} Captain2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Кубок группы", "teamLimit": 3}

### Организатор без CSRF (403)
POST {{baseUrl}}/api/tournaments
Authorization: Basic organizer@tournament.local Organize2026!
Content-Type: application/json

{"name": "Кубок группы", "teamLimit": 3}

### Организатор с неверным CSRF (403)
POST {{baseUrl}}/api/tournaments
Authorization: Basic organizer@tournament.local Organize2026!
X-CSRF-TOKEN: wrong
Content-Type: application/json

{"name": "Кубок группы", "teamLimit": 3}

### Создать турнир (201)
POST {{baseUrl}}/api/tournaments
Authorization: Basic organizer@tournament.local Organize2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Кубок группы", "teamLimit": 3}

> {% client.global.set("tournamentId", response.body.id); %}

### Недостаточно команд для старта (409)
POST {{baseUrl}}/api/tournaments/{{tournamentId}}/start
Authorization: Basic organizer@tournament.local Organize2026!
X-CSRF-TOKEN: {{csrfToken}}

### Команда Орлы (201)
POST {{baseUrl}}/api/teams
Authorization: Basic {{captain}} Captain2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Орлы", "captainId": {{captainId}}, "memberIds": [{{secondId}}]}

> {% client.global.set("teamOneId", response.body.id); %}

### Команда Волки (201)
POST {{baseUrl}}/api/teams
Authorization: Basic {{second}} Captain2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Волки", "captainId": {{secondId}}, "memberIds": [{{thirdId}}]}

> {% client.global.set("teamTwoId", response.body.id); %}

### Команда Метеор (201)
POST {{baseUrl}}/api/teams
Authorization: Basic {{third}} Captain2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Метеор", "captainId": {{thirdId}}, "memberIds": [{{captainId}}]}

> {% client.global.set("teamThreeId", response.body.id); %}

