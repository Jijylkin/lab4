@baseUrl = http://localhost:8080

### CSRF-токен (200)
GET {{baseUrl}}/api/account/csrf

> {% client.global.set("csrfToken", response.body.token); %}

### Профиль организатора (200)
GET {{baseUrl}}/api/account/me
Authorization: Basic organizer@tournament.local Organize2026!

> {% client.global.set("organizerId", response.body.id); %}

### Создать пользователя (201)
POST {{baseUrl}}/api/users
Authorization: Basic organizer@tournament.local Organize2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Денис", "email": "crud-player@example.com", "password": "Player2026!"}

> {% client.global.set("userId", response.body.id); %}

### Все пользователи (200)
GET {{baseUrl}}/api/users
Authorization: Basic organizer@tournament.local Organize2026!

### Пользователь по id (200)
GET {{baseUrl}}/api/users/{{userId}}
Authorization: Basic organizer@tournament.local Organize2026!

### Изменить пользователя (200)
PATCH {{baseUrl}}/api/users/{{userId}}
Authorization: Basic organizer@tournament.local Organize2026!
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"name": "Денис Попов"}

